 }
 
-/* Letterbox: largest num:den rect centered in the drawable. */
+static int s_integer_scale = 1;
+
+void gl_renderer_set_integer_scale(int on) {
+    GL_RT_SYNC("set_integer_scale");
+    on = on ? 1 : 0;
+    if (on == s_integer_scale) return;
+    s_integer_scale = on;
+    for (int i = 0; i < PRES_ROWS; i++) s_present_dirty[i] = ~0ull;
+    s_last_present_path = -1;
+    s_force_present_remaining = 2;
+    hold_invalidate();
+}
+
+int gl_renderer_get_integer_scale(void) { return s_integer_scale; }
+
+/* Letterbox: largest num:den rect centered in the drawable (with integer
+ * scaling, the largest whose height is a whole multiple of 240 lines). */
 static void letterbox_rect_aspect(int ww, int wh, int num, int den,
                                   int *x, int *y, int *w, int *h) {
     int dw = ww, dh = (ww * den) / num;
     if (dh > wh) { dh = wh; dw = (wh * num) / den; }
+    if (s_integer_scale && dh >= 240) {
+        dh = (dh / 240) * 240;
+        dw = (dh * num) / den;
+    }
     *x = (ww - dw) / 2;
     *y = (wh - dh) / 2;
     *w = dw; *h = dh;
