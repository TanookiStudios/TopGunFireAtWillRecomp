@@ -2905,10 +2905,73 @@ static std::filesystem::path find_upward(std::filesystem::path start,
 // authoritative source (independent of argv[0], which can be relative/bare and
 // would otherwise get resolved against cwd by fs::absolute). $APPIMAGE and
 // argv[0] are non-Windows / fallback sources only.
+#if defined(__APPLE__)
+#include <mach-o/dyld.h>
+/* Inside a Mac .app the program's folder is read-only (and writing there
+ * would break the code signature). Settings, saves, memory cards and caches
+ * go to ~/Library/Application Support/<program name>/ instead, refreshed from
+ * the app's Contents/Resources every launch so a moved or updated app is
+ * followed: its folders are linked (read-only data), its loose files are
+ * copied (the runtime writes to some, e.g. game.toml), and saves/ and mods/
+ * are real folders (mods/ holds the player's state.toml; its bundled
+ * packages are links). The player's own files are never replaced. */
+static void link_bundle_entries(const std::filesystem::path& from,
+                                const std::filesystem::path& to,
+                                const std::filesystem::path& skip) {
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    for (const auto& e : fs::directory_iterator(from, ec)) {
+        const fs::path name = e.path().filename();
+        if (name == skip) continue;
+        const fs::path dst = to / name;
+        if (e.is_directory(ec) && (name == "mods" || name == "saves")) {
+            if (fs::is_symlink(dst, ec)) fs::remove(dst, ec);
+            fs::create_directories(dst, ec);
+            if (name == "mods") link_bundle_entries(e.path(), dst, fs::path());
+            continue;
+        }
+        const bool ours = fs::is_symlink(dst, ec) || !fs::exists(dst, ec) ||
+                          e.is_regular_file(ec);   /* a loose file the app ships */
+        if (!ours) continue;                       /* the player's own folder */
+        fs::remove(dst, ec);
+        if (e.is_directory(ec)) fs::create_symlink(e.path(), dst, ec);
+        else fs::copy_file(e.path(), dst, fs::copy_options::overwrite_existing, ec);
+    }
+}
+static std::filesystem::path mac_app_data_dir(void) {
+    namespace fs = std::filesystem;
+    static fs::path cached;
+    static bool done = false;
+    if (done) return cached;
+    done = true;
+    char buf[4096];
+    uint32_t size = sizeof(buf);
+    if (_NSGetExecutablePath(buf, &size) != 0) return cached;
+    std::error_code ec;
+    const fs::path exe = fs::weakly_canonical(fs::path(buf), ec);
+    if (ec) return cached;
+    const fs::path bin = exe.parent_path();
+    if (bin.filename() != "MacOS" || bin.parent_path().filename() != "Contents" ||
+        bin.parent_path().parent_path().extension() != ".app")
+        return cached;   /* a plain build folder: stay beside the program */
+    const char* home = std::getenv("HOME");
+    if (!home || !home[0]) return cached;
+    const fs::path data = fs::path(home) / "Library" / "Application Support" / exe.filename();
+    fs::create_directories(data, ec);
+    if (ec) return cached;
+    link_bundle_entries(bin.parent_path() / "Resources", data, exe.filename());
+    cached = data;
+    return cached;
+}
+#endif
+
 static std::filesystem::path exe_dir_from_argv(const char* argv0) {
     namespace fs = std::filesystem;
     std::error_code ec;
     fs::path exe_dir;
+#if defined(__APPLE__)
+    if (const fs::path data = mac_app_data_dir(); !data.empty()) return data;
