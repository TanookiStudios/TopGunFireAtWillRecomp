diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index 526a3d56..4bc4a4b4 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -20212,6 +20212,12 @@ session_reboot:
      * set the PSX-visible connection + pad type so the BIOS sees the right
      * ports during early boot. */
     for (int s = 0; s < PSX_MAX_PLAYERS; ++s) {
+        /* One-player game: player 1 on "keyboard" also takes the first
+         * controller (keyboard binds stay live alongside a pad), so a pad
+         * plugged in later, or the launcher saving "Keyboard", never locks
+         * the player out of one or the other. */
+        if (PSX_MAX_PLAYERS == 1 && s == 0 && lower_copy(trim_copy(player_device[s])) == "keyboard")
+            player_device[s] = "gamepad";
         set_player_device(g_players[s], player_device[s], player_mode[s]);
         g_players[s].preferred_instance = player_instance[s]
             ? (SDL_JoystickID)(player_instance[s] - 1) : -1;
