+/* Player mutes (host only, never seen by the game): bits of
+ * g_spu_host_mute. MUSIC silences the CD input bus (music and movie sound),
+ * SFX the 24 voices (with their reverb send), REVERB the reverb's output. */
+#define SPU_HOST_MUTE_MUSIC  1u
+#define SPU_HOST_MUTE_SFX    2u
+#define SPU_HOST_MUTE_REVERB 4u
+extern volatile unsigned g_spu_host_mute;
+
 /* Host gate: while it returns nonzero (rollback resimulation, FMV-skip mute)
  * rendered samples advance SPU state but are not queued. */
 void spu_set_output_gate(int (*suppressed)(void));
