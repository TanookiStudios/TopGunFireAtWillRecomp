+/* Controllers work with no setup: SDL's community database (over 2,000 pads
+ * by name, bundled as assets/gamecontrollerdb.txt), then the player's own
+ * gamecontrollerdb.txt in the settings folder, whose lines win. Call after
+ * SDL's controller support starts; safe to repeat. */
+static void load_controller_db(const char* argv0);
+
 static std::filesystem::path resolve_existing_runtime_path(const char* requested,
                                                            const char* argv0) {
     namespace fs = std::filesystem;
@@ -3017,6 +3023,21 @@ static std::filesystem::path resolve_existing_runtime_path(const char* requested
     return {};
 }
 
+static void load_controller_db(const char* argv0) {
+    namespace fs = std::filesystem;
+    const fs::path dir = exe_dir_from_argv(argv0);
+    for (const fs::path& f : {dir / "assets" / "gamecontrollerdb.txt", dir / "gamecontrollerdb.txt"}) {
+        std::error_code ec;
+        if (!fs::is_regular_file(f, ec)) continue;
+#if defined(PSX_SDL3)
+        const int n = SDL_AddGamepadMappingsFromFile(f.string().c_str());
+#else
+        const int n = SDL_GameControllerAddMappingsFromFile(f.string().c_str());
+#endif
+        std::fprintf(stderr, "psxrecomp: controller database %s: %d mappings\n", f.string().c_str(), n);
+    }
+}
+
