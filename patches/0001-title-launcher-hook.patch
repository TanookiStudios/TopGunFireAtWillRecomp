diff --git a/runtime/include/psx_title_host.h b/runtime/include/psx_title_host.h
new file mode 100644
index 00000000..4e98a42e
--- /dev/null
+++ b/runtime/include/psx_title_host.h
@@ -0,0 +1,23 @@
+/* psx_title_host.h -- a title's hook into the pre-game launcher and the
+ * in-game menu's launcher info.
+ *
+ * The runtime fills RecompLauncherCGameInfo itself, then calls the hook (if a
+ * title registered one) so the title can add what only it knows: its own
+ * option rows (game_items / game_callbacks), an About page (about_*), or turn
+ * a page off (mods = NULL). Register from a static constructor
+ * (PSX_MOD_CONSTRUCTOR in mod_plugins.h) so it is set before main(). */
+#ifndef PSX_TITLE_HOST_H
+#define PSX_TITLE_HOST_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct RecompLauncherCGameInfo;
+typedef void (*PsxTitleLauncherHook)(struct RecompLauncherCGameInfo* gi);
+void psx_title_set_launcher_hook(PsxTitleLauncherHook hook);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
