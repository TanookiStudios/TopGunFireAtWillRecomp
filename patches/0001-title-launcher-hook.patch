 #include "psx_keybinds.h"
 #include "host_overlay.h"
 #include "psx_menu_host.h"     /* optional in-game menu hooks (P1 pause, ...) */    /* configurable keyboard->DualShock keybinds (keybinds.ini) */
+#include "psx_title_host.h"     /* a title's launcher-info hook (Game / About pages) */
+static PsxTitleLauncherHook g_psx_title_launcher_hook = nullptr;
+extern "C" void psx_title_set_launcher_hook(PsxTitleLauncherHook hook) {
+    g_psx_title_launcher_hook = hook;
+}
 #include "psx_window_icon.h"
 
 #if defined(RECOMP_LAUNCHER)
@@ -16507,6 +16512,7 @@ namespace {
 #else
         gi->resume_netplay_endpoint = nullptr;
 #endif
+        if (g_psx_title_launcher_hook) g_psx_title_launcher_hook(gi);
     }
 }  // namespace
 #endif
@@ -16744,6 +16750,7 @@ void mh_launcher_game_info(RecompLauncherCGameInfo* out) {
     gi.netplay_supported = g_lnch_netplay_available ? 1 : 0;
     gi.netplay = g_lnch_netplay_available ? &g_lnch_netplay_callbacks : nullptr;
 #endif
